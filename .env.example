# Production site URL. Used by canonical URLs, the sitemap, and structured data.
SITE_URL=https://chienyinwu.com

# Umami: create a website at https://cloud.umami.is and copy its Website ID.
# Copy this file to .env.local for local builds. Development visits are not tracked.
# For GitHub Pages, add UMAMI_WEBSITE_ID under repository Settings > Secrets and variables > Actions > Variables.
NEXT_UMAMI_ID=

# Optional overrides for a self-hosted Umami instance or additional production domains.
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_DOMAINS=chienyinwu.com

# Optional Google Search Console HTML verification token (the content value only).
GOOGLE_SITE_VERIFICATION=
